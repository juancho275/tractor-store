{
  "version": 1,
  "projects": {
    "ts-design-system": {
      "projectType": "library",
      "root": "packages/ts-design-system",
      "sourceRoot": "packages/ts-design-system/src",
      "architect": {
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "packages/ts-design-system/.storybook",
            "browserTarget": "ts-design-system:build",
            "port": 6006,
            "compodoc": false
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "packages/ts-design-system/.storybook",
            "browserTarget": "ts-design-system:build",
            "outputDir": "packages/ts-design-system/storybook-static",
            "compodoc": false
          }
        },
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/ts-design-system",
            "index": "packages/ts-design-system/src/index.html",
            "main": "packages/ts-design-system/src/main.ts",
            "tsConfig": "packages/ts-design-system/tsconfig.lib.json",
            "polyfills": ["zone.js"],
            "assets": [],
            "styles": [],
            "scripts": []
          }
        }
      }
    }
  },
  "defaultProject": "ts-design-system",
  "cli": {
    "analytics": false
  }
}