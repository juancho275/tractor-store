{
  "name": "mfeExplore",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "packages/mfe-explore/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/mfe-explore",
        "index": "packages/mfe-explore/src/index.html",
        "main": "packages/mfe-explore/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "packages/mfe-explore/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "packages/mfe-explore/public"
          }
        ],
        "styles": ["packages/mfe-explore/src/styles.scss"],
        "customWebpackConfig": {
          "path": "packages/mfe-explore/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "customWebpackConfig": {
            "path": "packages/mfe-explore/webpack.prod.config.ts"
          },
          "fileReplacements": [
            {
              "replace": "packages/mfe-explore/src/environments/environment.ts",
              "with": "packages/mfe-explore/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/angular:dev-server",
      "options": {
        "port": 4201,
        "publicHost": "http://localhost:4201"
      },
      "configurations": {
        "production": {
          "buildTarget": "mfeExplore:build:production"
        },
        "development": {
          "buildTarget": "mfeExplore:build:development"
        }
      },
      "defaultConfiguration": "development",
      "dependsOn": []
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "mfeExplore:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/mfe-explore/jest.config.ts",
        "tsConfig": "packages/mfe-explore/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "defaultConfiguration": "production",
      "options": {
        "buildTarget": "mfeExplore:build",
        "port": 4201,
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "mfeExplore:build:development"
        },
        "production": {
          "buildTarget": "mfeExplore:build:production"
        }
      }
    }
  }
}
